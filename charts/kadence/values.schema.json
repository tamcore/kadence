{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "kadence chart values",
  "description": "MINIMAL schema (D11): types and required-ness on the critical keys only. Not exhaustive — most values.yaml keys are intentionally left unvalidated here.",
  "type": "object",
  "required": ["image", "replicaCount", "resources", "postgres", "secrets", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "resources": { "type": "object" },
    "postgres": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "password": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "secrets": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultDeny": { "type": "boolean" }
      }
    }
  }
}
